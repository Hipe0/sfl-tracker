MONGODB_URI=
SFL_API_KEY=

# Đồng bộ farm mỗi phút vào collection `farms`
# Danh sách farm id, cách nhau bằng dấu phẩy. Các farm đã có trong collection `history` cũng được đồng bộ.
SYNC_FARM_IDS=
# Đặt false để không lấy thêm farm từ collection `history`
SYNC_INCLUDE_HISTORY_FARMS=true
# Đặt false để tắt cron trong server.cjs
FARM_SYNC_ENABLED=true
FARM_SYNC_CRON=* * * * *
# Bí mật cho GET /api/cron/farm-sync (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=

# Báo cáo FLIP (lãi/lỗ lướt sóng theo FIFO), chỉ dành cho chủ farm.
# Để FLIP_ENABLED=false (hoặc bỏ trống) trên bản deploy công khai: /api/flip sẽ không tồn tại.
FLIP_ENABLED=false
# Mã bí mật, gửi qua header x-flip-key. Tạo bằng: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
FLIP_OWNER_KEY=
# Farm được xem báo cáo và được lưu giao dịch tự động
FLIP_FARM_IDS=
# Người dùng tự đăng ký FLIP bằng Farm ID + API key SFL của họ (mỗi key một hàng đợi riêng).
# Bí mật dùng để mã hoá API key của người dùng trong MongoDB. Đổi bí mật này thì key cũ không giải mã được.
# Tạo bằng: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
FLIP_KEY_SECRET=
# Đặt false để tắt đăng ký mới (người đã đăng ký vẫn dùng được)
FLIP_PUBLIC_SIGNUP=true
FLIP_MAX_USERS=100
# Nhịp lấy giao dịch (API chỉ trả 50 lệnh gần nhất): 75 giây một lượt. Đừng để dưới 70: API profile chặn 429 nếu gọi sát nhau ~1 phút
FLIP_SYNC_INTERVAL_SECONDS=75
# true = bật lại chế độ gom hàng (nhịp nhanh 10 giây, nút "Đang gom hàng"). Mặc định tắt
FLIP_FAST_MODE=false
FLIP_FAST_INTERVAL_SECONDS=10
# Số lệnh mới trong một lượt để tự chuyển sang nhịp nhanh
FLIP_BURST_THRESHOLD=10
# Múi giờ gom theo ngày, tính bằng phút so với UTC (420 = UTC+7)
FLIP_TZ_OFFSET_MINUTES=420

# ---------- App chỉ còn FLIP ----------
# true = bật lại job nền của các tính năng cũ (đấu giá, theo dõi farm). Giao diện cũ bật ở src/config/features.js
FEATURE_LEGACY=false
# false = không thu thập dữ liệu chợ (trang Thị trường & Điểm mua sẽ trống)
FEATURE_MARKET=true
# Lấp lịch sử giá theo ngày bằng API game giờ chạy tay: npm run market:backfill (xét MARKET_BACKFILL_DAYS ngày gần nhất).
# Server chỉ gọi API game 15 phút/lần để lấy giá (+ giao dịch Flip). true = tự lấp khi khởi động và mỗi giờ như bản cũ
MARKET_BACKFILL_AUTO=false
MARKET_BACKFILL_DAYS=330
# Số lệnh Mua tối đa cùng lúc (chỉ báo Mua cho N món tốt nhất theo vòng mùa).
# Bỏ trống = tự chọn theo backtest: MARKET_BUY_MODE=now → 2, trough → 3
MARKET_TOP_N=
# trough = canh đáy: đặt offer ở giá đáy dự kiến trong 28 ngày tới (mặc định); now = mua ngay ở giá sàn
MARKET_BUY_MODE=trough
# Hàng trong kho (Wheat/Stone/Wood...): p90 = báo Bán khi giá vào nhóm 10% ngày cao nhất của món (mặc định);
# avgpeak = chỉ báo Bán khi chạm trung bình các đỉnh cũ (chặt hơn, có món cả năm không chạm)
STOCK_SELL_RULE=p90
# false = không tải nightly dump (~800 MB/ngày) để đếm active supply + holders
MARKET_DUMP_ENABLED=true

# Bot Telegram báo top Mua, offer khớp/hết hạn, hàng đang giữ tới lúc bán (để trống = tắt).
# Tạo bot bằng @BotFather, dán token vào đây, rồi nhắn cho bot: /start <FLIP_OWNER_KEY>
TELEGRAM_BOT_TOKEN=
# (không bắt buộc) chat id nhận tin, nhiều id cách nhau dấu phẩy; bỏ trống thì đăng ký bằng lệnh /start
TELEGRAM_CHAT_ID=
# false = không tự mở phiên gom khi thấy lệnh mua mới khớp
FLIP_AUTO_SESSION=true

# Trang /widget cho hình nền (Lively Wallpaper) và màn hình khoá (scripts/lockscreen/install-lockscreen.ps1).
# Địa chỉ backend mà script khoá màn hình chụp: URL backend trên Render (localhost chỉ để test); mã đọc từ FLIP_OWNER_KEY ở trên
WIDGET_URL=https://<ten-app>.onrender.com
# Ảnh nền màn hình khoá: soc1|soc2|soc3|none|<url ảnh>, vị trí khung: br (góc dưới phải)|right|left|center
WIDGET_BG=soc3
WIDGET_POS=br
